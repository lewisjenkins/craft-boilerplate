# This folder doubles as a working Craft install AND the boilerplate repo.
# Track only the boilerplate-relevant files; ignore everything else
# (vendor, node_modules, Craft scaffolding, build output, etc.)

/*

!/.gitignore
!/CLAUDE.md
!/install.sh
!/package.json
!/README.md
!/src
!/templates

# Track web/dist/fonts/ (self-hosted font files) and web/dist/build.css (compiled CSS,
# inlined into the HTML head via templates/_build.css symlink). Everything else in
# web/ is local-only.
!/web
/web/*
!/web/dist
/web/dist/*
!/web/dist/fonts
!/web/dist/build.css
