# This folder doubles as a working Craft install AND the boilerplate repo.
# Track only the boilerplate-relevant files; ignore everything else
# (vendor, node_modules, Craft scaffolding, build output, etc.)

/*

!/.gitignore
!/CLAUDE.md
!/CLAUDE.dist.md
!/install.sh
!/package.json
!/README.md
!/src
!/templates

# Track web/dist/fonts/ (self-hosted font files travel with the boilerplate).
# Everything else in web/ — including the compiled web/dist/build.css — is
# local-only; run `npm run css` to (re)build.
!/web
/web/*
!/web/dist
/web/dist/*
!/web/dist/fonts
